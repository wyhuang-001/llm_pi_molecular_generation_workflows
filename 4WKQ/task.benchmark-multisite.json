{
  "task": "Optimize the 4WKQ EGFR ligand with the cut-point-free closed pool. Choose one host-listed site and one change type the site allows, or STOP.",
  "complex_path": "4WKQ_-_hbond-opt.pdb",
  "ligand_selector": {
    "chain": "A",
    "residue_name": "IRE",
