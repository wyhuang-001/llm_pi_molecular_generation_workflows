    "transport": "stdio",
    "mcp_command": "npx -y @playwright/mcp@latest",
    "timeout_seconds": 180,
    "calls": [
      {
        "tool": "browser_navigate",
        "arguments": {"url": "https://www.rcsb.org/structure/4WKQ"}
      },
      {
        "tool": "browser_snapshot",
        "arguments": {}
      }
    ]
  },
  "receptor_preparation": {
